rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Solo usuarios autenticados (Email/Password, creados desde la consola
    // de Firebase) pueden leer y escribir en las colecciones de la app.
    // Nadie puede acceder sin haber iniciado sesión.

    match /grupos/{grupoId} {
      allow read, write: if request.auth != null;
    }

    match /ninos/{ninoId} {
      allow read, write: if request.auth != null;
    }

    match /abonos/{abonoId} {
      allow read, write: if request.auth != null;
    }

    // Cualquier otra colección queda denegada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
